filters:
  and:
    - '!file.path.contains("Templates")'
    - entity == link("Projects.base", "Project")
views:
  - type: table
    name: All
  - type: table
    name: Ongoing
    filters:
      and:
        - status == "ongoing"
  - type: table
    name: Completed
    filters:
      and:
        - status == "completed"

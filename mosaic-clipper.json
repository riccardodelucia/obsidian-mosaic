{
	"schemaVersion": "0.1.0",
	"name": "Mosaic",
	"behavior": "create",
	"noteContentFormat": "{{content}}",
	"properties": [
		{
			"name": "created",
			"value": "{{date}}",
			"type": "date"
		},
		{
			"name": "entity",
			"value": "[[Resources.base|Resource]]",
			"type": "text"
		},
		{
			"name": "categories",
			"value": "[[Clippings.base|Clipping]]",
			"type": "multitext"
		},
		{
			"name": "descriptors",
			"value": "",
			"type": "multitext"
		},
		{
			"name": "tags",
			"value": "",
			"type": "multitext"
		},
		{
			"name": "title",
			"value": "{{title}}",
			"type": "text"
		},
		{
			"name": "source",
			"value": "{{url}}",
			"type": "text"
		},
		{
			"name": "authors",
			"value": "{{author|split:\\\", \\\"|wikilink|join}}",
			"type": "multitext"
		},
		{
			"name": "published",
			"value": "{{published}}",
			"type": "date"
		},
		{
			"name": "description",
			"value": "{{description}}",
			"type": "text"
		}
	],
	"triggers": [],
	"noteNameFormat": "{{title}}",
	"path": "Inbox"
}